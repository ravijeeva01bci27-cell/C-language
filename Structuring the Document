#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct word kth_word_in_mth_sentence_of_nth_paragraph(struct document Doc, int k, int m, int n) {
    return Doc.data[n-1].data[m-1].data[k-1];
}

struct sentence kth_sentence_in_mth_paragraph(struct document Doc, int k, int m) {
    return Doc.data[m-1].data[k-1];
}

struct paragraph kth_paragraph(struct document Doc, int k) {
    return Doc.data[k-1];
}

void get_document(char* text) {
    // Initialize the global document structure
    Doc.data = malloc(MAX_PARAGRAPHS * sizeof(struct paragraph));
    Doc.paragraph_count = 0;

    char *p_save, *s_save, *w_save;
    char *p_token = strtok_r(text, "\n", &p_save);

    while (p_token != NULL) {
        struct paragraph *curr_p = &Doc.data[Doc.paragraph_count];
        curr_p->data = malloc(MAX_SENTENCES * sizeof(struct sentence));
        curr_p->sentence_count = 0;

        char *s_token = strtok_r(p_token, ".", &s_save);
        while (s_token != NULL) {
            struct sentence *curr_s = &curr_p->data[curr_p->sentence_count];
            curr_s->data = malloc(MAX_WORDS * sizeof(struct word));
            curr_s->word_count = 0;

            char *w_token = strtok_r(s_token, " ", &w_save);
            while (w_token != NULL) {
                struct word *curr_w = &curr_s->data[curr_s->word_count];
                curr_w->data = strdup(w_token); // Copy string data
                curr_s->word_count++;
                w_token = strtok_r(NULL, " ", &w_save);
            }
            curr_p->sentence_count++;
            s_token = strtok_r(NULL, ".", &s_save);
        }
        Doc.paragraph_count++;
        p_token = strtok_r(NULL, "\n", &p_save);
    }
}

