#include <stdio.h>
#include <time.h>
#include <unistd.h> // Use #include <windows.h> if on Windows

int main() {
    while (1) {
        time_t rawTime;
        struct tm * currentTime;
        
        time(&rawTime);
        currentTime = localtime(&rawTime);

        // Clears the console screen
        printf("\033[H\033[J"); 

        printf("--- Digital Clock ---\n");
        printf("      %02d:%02d:%02d\n", currentTime->tm_hour, currentTime->tm_min, currentTime->tm_sec);
        printf("---------------------\n");

        sleep(1); // Wait for 1 second (use Sleep(1000) for Windows)
    }
    return 0;
}
