#include <stdio.h>

char board[3][3] = {{'1','2','3'},{'4','5','6'},{'7','8','9'}};
int choice;
int row, column;
char turn = 'X';

void display_board() {
    printf("\n  %c | %c | %c \n", board[0][0], board[0][1], board[0][2]);
    printf(" ---|---|--- \n");
    printf("  %c | %c | %c \n", board[1][0], board[1][1], board[1][2]);
    printf(" ---|---|--- \n");
    printf("  %c | %c | %c \n", board[2][0], board[2][1], board[2][2]);
}

int main() {
    int i;
    for(i = 0; i < 9; i++) {
        display_board();
        printf("Player %c, enter position: ", turn);
        scanf("%d", &choice);
        row = (choice - 1) / 3;
        column = (choice - 1) % 3;
        board[row][column] = turn;
        turn = (turn == 'X') ? 'O' : 'X';
    }
    display_board();
    printf("Game Over!\n");
    return 0;
}
