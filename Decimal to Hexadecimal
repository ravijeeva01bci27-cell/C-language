#include <stdio.h>

int main() {
    int n, i = 0;
    char hex[50];
    printf("Enter Decimal Number: ");
    scanf("%d", &n);

    while(n != 0) {
        int temp = n % 16;
        if(temp < 10) hex[i++] = temp + 48; // 0-9
        else hex[i++] = temp + 55;          // A-F
        n /= 16;
    }

    printf("Hexadecimal: ");
    for(int j = i - 1; j >= 0; j--) printf("%c", hex[j]);
    return 0;
}
