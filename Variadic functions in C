#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>

int sum(int count, ...) {
    int total = 0;
    va_list args;
    va_start(args, count); // Initialize the list starting after 'count'

    for (int i = 0; i < count; i++) {
        total += va_arg(args, int); // Get next int
    }

    va_end(args); // Clean up
    return total;
}

int min(int count, ...) {
    va_list args;
    va_start(args, count);

    // Initialize min with the first argument
    int minimum = va_arg(args, int);

    for (int i = 1; i < count; i++) {
        int current = va_arg(args, int);
        if (current < minimum) {
            minimum = current;
        }
    }

    va_end(args);
    return minimum;
}

int max(int count, ...) {
    va_list args;
    va_start(args, count);

    // Initialize max with the first argument
    int maximum = va_arg(args, int);

    for (int i = 1; i < count; i++) {
        int current = va_arg(args, int);
        if (current > maximum) {
            maximum = current;
        }
    }

    va_end(args);
    return maximum;
}
