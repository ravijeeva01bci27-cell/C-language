#include <stdio.h>

int libraryFine(int d1, int m1, int y1, int d2, int m2, int y2) {
    // Case 1: Returned after the expected year
    if (y1 > y2) {
        return 10000;
    }
    
    // Case 2: Returned within the same year
    if (y1 == y2) {
        // Returned after the expected month
        if (m1 > m2) {
            return 500 * (m1 - m2);
        }
        // Returned within the same month
        if (m1 == m2) {
            // Returned after the expected day
            if (d1 > d2) {
                return 15 * (d1 - d2);
            }
        }
    }

    // Case 3: Returned on or before the due date
    // (This includes returning it in a previous month or year)
    return 0;
}

int main() {
    int d1, m1, y1; // Actual return date
    int d2, m2, y2; // Expected return date

    if (scanf("%d %d %d", &d1, &m1, &y1) != 3) return 0;
    if (scanf("%d %d %d", &d2, &m2, &y2) != 3) return 0;

    int result = libraryFine(d1, m1, y1, d2, m2, y2);
    printf("%d\n", result);

    return 0;
}
