#include <stdio.h>
#define MAX 5

int stack[MAX], top = -1;

void push(int val) {
    if (top == MAX - 1) printf("Stack Overflow\n");
    else stack[++top] = val;
}

int main() {
    push(10); push(20); push(30);
    printf("Top element: %d\n", stack[top]);
    printf("Popping: %d\n", stack[top--]);
    printf("New top: %d\n", stack[top]);
    return 0;
}
