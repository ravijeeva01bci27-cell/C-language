#include <stdio.h>
#include <stdlib.h>

/*
 * Helper function to reverse an integer
 * Example: 120 -> 21
 */
int reverse_number(int n) {
    int reversed = 0;
    while (n > 0) {
        reversed = reversed * 10 + (n % 10);
        n /= 10;
    }
    return reversed;
}

/*
 * Complete the 'beautifulDays' function
 */
int beautifulDays(int i, int j, int k) {
    int beautiful_count = 0;

    for (int day = i; day <= j; day++) {
        int rev = reverse_number(day);
        
        // Calculate absolute difference
        int diff = abs(day - rev);
        
        // Check if divisible by k
        if (diff % k == 0) {
            beautiful_count++;
        }
    }

    return beautiful_count;
}

int main() {
    int i, j, k;
    
    // Read starting day, ending day, and divisor
    if (scanf("%d %d %d", &i, &j, &k) != 3) return 0;

    int result = beautifulDays(i, j, k);
    printf("%d\n", result);

    return 0;
}
