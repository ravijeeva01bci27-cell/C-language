#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    int l = 0, h, isPal = 1;
    printf("Enter string: "); scanf("%s", str);
    
    h = strlen(str) - 1;
    while (h > l) {
        if (str[l++] != str[h--]) {
            isPal = 0;
            break;
        }
    }
    printf("%s is %s\n", str, isPal ? "a Palindrome" : "not a Palindrome");
    return 0;
}
