#include <stdio.h>
#include <stdlib.h>

/*
 * Complete the 'angryProfessor' function below.
 * Returns "YES" if class is cancelled, "NO" otherwise.
 */
char* angryProfessor(int k, int a_count, int* a) {
    int on_time_count = 0;

    for (int i = 0; i < a_count; i++) {
        // Students with non-positive arrival times are on time
        if (a[i] <= 0) {
            on_time_count++;
        }
    }

    // If on-time students are fewer than threshold k, cancel class
    if (on_time_count < k) {
        return "YES";
    } else {
        return "NO";
    }
}

int main() {
    int t;
    if (scanf("%d", &t) != 1) return 0;

    while (t--) {
        int n, k;
        scanf("%d %d", &n, &k);
        
        int *a = malloc(n * sizeof(int));
        for (int i = 0; i < n; i++) {
            scanf("%d", &a[i]);
        }

        char* result = angryProfessor(k, n, a);
        printf("%s\n", result);

        free(a);
    }

    return 0;
}
