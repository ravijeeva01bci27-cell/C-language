#include <stdio.h>
#include <stdlib.h>
#include <string.h>

void print_all_packages(town t) {
    printf("%s:\n", t.name);
    for (int i = 0; i < t.offices_count; i++) {
        printf("\t%d:\n", i);
        for (int j = 0; j < t.offices[i].packages_count; j++) {
            printf("\t\t%s\n", t.offices[i].packages[j].id);
        }
    }
}

void send_all_acceptable_packages(town* source, int source_index, town* target, int target_index) {
    post_office *src = &(source->offices[source_index]);
    post_office *tgt = &(target->offices[target_index]);
    
    // Temporary storage for rejected packages
    package *rejected = malloc(sizeof(package) * src->packages_count);
    int rejected_count = 0;
    
    for (int i = 0; i < src->packages_count; i++) {
        package p = src->packages[i];
        if (p.weight >= tgt->min_weight && p.weight <= tgt->max_weight) {
            // Move to target
            tgt->packages = realloc(tgt->packages, sizeof(package) * (tgt->packages_count + 1));
            tgt->packages[tgt->packages_count++] = p;
        } else {
            // Keep for source
            rejected[rejected_count++] = p;
        }
    }
    
    // Update source office with only rejected packages
    free(src->packages);
    if (rejected_count > 0) {
        src->packages = malloc(sizeof(package) * rejected_count);
        for (int i = 0; i < rejected_count; i++) {
            src->packages[i] = rejected[i];
        }
    } else {
        src->packages = NULL;
    }
    src->packages_count = rejected_count;
    
    free(rejected);
}

town town_with_most_packages(town* towns, int towns_count) {
    int max_pkgs = -1;
    int index = 0;
    for (int i = 0; i < towns_count; i++) {
        int current_pkgs = 0;
        for (int j = 0; j < towns[i].offices_count; j++) {
            current_pkgs += towns[i].offices[j].packages_count;
        }
        if (current_pkgs > max_pkgs) {
            max_pkgs = current_pkgs;
            index = i;
        }
    }
    return towns[index];
}

town* find_town(town* towns, int towns_count, char* name) {
    for (int i = 0; i < towns_count; i++) {
        if (strcmp(towns[i].name, name) == 0) {
            return &towns[i];
        }
    }
    return NULL;
}
