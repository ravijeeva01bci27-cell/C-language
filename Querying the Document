#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* kth_word_in_mth_sentence_of_nth_paragraph(char**** document, int k, int m, int n) {
    // k, m, n are usually 1-indexed in these challenges
    return document[n-1][m-1][k-1];
}

char** kth_sentence_in_mth_paragraph(char**** document, int k, int m) {
    return document[m-1][k-1];
}

char*** kth_paragraph(char**** document, int k) {
    return document[k-1];
}

char**** get_document(char* text) {
    char**** doc = malloc(MAX_PARAGRAPHS * sizeof(char***));
    int p = 0, s = 0, w = 0;
    
    // Split by Paragraphs
    char* p_ptr;
    char* p_save;
    char* p_token = strtok_r(text, "\n", &p_save);
    
    while (p_token != NULL) {
        doc[p] = malloc(100 * sizeof(char**)); // Max sentences placeholder
        s = 0;
        
        // Split Paragraph into Sentences
        char* s_save;
        char* s_token = strtok_r(p_token, ".", &s_save);
        while (s_token != NULL) {
            doc[p][s] = malloc(100 * sizeof(char*)); // Max words placeholder
            w = 0;
            
            // Split Sentence into Words
            char* w_save;
            char* w_token = strtok_r(s_token, " ", &w_save);
            while (w_token != NULL) {
                doc[p][s][w] = strdup(w_token);
                w++;
                w_token = strtok_r(NULL, " ", &w_save);
            }
            s++;
            s_token = strtok_r(NULL, ".", &s_save);
        }
        p++;
        p_token = strtok_r(NULL, "\n", &p_save);
    }
    return doc;
}
