#include <stdio.h>

// Recursive function to calculate the nth term
int find_nth_term(int n, int a, int b, int c) {
    // Base cases: return the initial terms for n = 1, 2, or 3
    if (n == 1) return a;
    if (n == 2) return b;
    if (n == 3) return c;

    // Recursive step: S(n) = S(n-1) + S(n-2) + S(n-3)
    return find_nth_term(n - 1, a, b, c) + 
           find_nth_term(n - 2, a, b, c) + 
           find_nth_term(n - 3, a, b, c);
}

int main() {
    int n, a, b, c;

    // Read n and the first three terms
    if (scanf("%d %d %d %d", &n, &a, &b, &c) != 4) return 0;

    // Calculate and print the nth term
    int ans = find_nth_term(n, a, b, c);
    printf("%d\n", ans);

    return 0;
}
