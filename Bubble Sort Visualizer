#include <stdio.h>

int main() {
    int arr[] = {64, 34, 25, 12, 22};
    int n = 5;

    for (int i = 0; i < n-1; i++) {
        for (int j = 0; j < n-i-1; j++) {
            if (arr[j] > arr[j+1]) {
                int temp = arr[j];
                arr[j] = arr[j+1];
                arr[j+1] = temp;
            }
        }
        // Print progress
        printf("Step %d: ", i + 1);
        for(int k=0; k<n; k++) printf("%d ", arr[k]);
        printf("\n");
    }
    return 0;
}
