#include <stdio.h>

struct Student {
    char name[50];
    int roll;
    float marks[3];
    float average;
};

int main() {
    int n;
    printf("Enter number of students: ");
    scanf("%d", &n);

    struct Student s[n];

    for (int i = 0; i < n; i++) {
        printf("\nEnter details for student %d:\n", i + 1);
        printf("Name: "); scanf("%s", s[i].name);
        printf("Roll No: "); scanf("%d", &s[i].roll);
        
        float sum = 0;
        for (int j = 0; j < 3; j++) {
            printf("Subject %d Marks: ", j + 1);
            scanf("%f", &s[i].marks[j]);
            sum += s[i].marks[j];
        }
        s[i].average = sum / 3.0;
    }

    printf("\n--- Student Records ---\n");
    for (int i = 0; i < n; i++) {
        printf("Roll: %d | Name: %s | Average: %.2f\n", s[i].roll, s[i].name, s[i].average);
    }

    return 0;
}
