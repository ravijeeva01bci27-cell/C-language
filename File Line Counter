#include <stdio.h>

int main() {
    FILE *fp = fopen("test.txt", "r");
    char ch;
    int lines = 0;

    if(!fp) return printf("File not found!\n"), 0;

    while((ch = fgetc(fp)) != EOF) {
        if(ch == '\n') lines++;
    }
    fclose(fp);
    printf("Total Lines: %d\n", lines + 1);
    return 0;
}
